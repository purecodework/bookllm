# =============================================================
# BookLLM environment variables
#
# Single-machine local use: no .env file needed.
#   Run: docker compose up -d
#   Configure LLM in the Settings UI — stored in the database,
#   OPENAI_* variables below are only used as initial fallbacks.
#
# When you need to edit this file:
#   1. LAN / remote access — set API_URL + CORS_ORIGIN,
#      then rebuild: docker compose up -d --build frontend
#   2. Hardening DB credentials — change POSTGRES_PASSWORD
#
# Usage: cp .env.example .env  (then edit as needed)
# =============================================================

# --- LAN / remote access -----------------------------------------------
# Backend URL as seen from the user's browser. Injected at container
# start — no rebuild needed. Change and restart the frontend container.
# Example: API_URL=http://192.168.1.100:3001
API_URL=http://localhost:3001

# Allowed CORS origin for the backend.
# Use * to allow all origins (convenient behind a reverse proxy).
# Example: CORS_ORIGIN=http://192.168.1.100:3000
CORS_ORIGIN=

# --- Frontend ----------------------------------------------------------
FRONTEND_PORT=3000

# --- Docker image names (override before pushing to a registry) --------
# Example:
# FRONTEND_IMAGE=kentcode/bookllm-frontend:0.1.1
# BACKEND_IMAGE=kentcode/bookllm-backend:0.1.1
# OCR_IMAGE=kentcode/bookllm-ocr:0.1.1
FRONTEND_IMAGE=kentcode/bookllm-frontend:latest
BACKEND_IMAGE=kentcode/bookllm-backend:latest
OCR_IMAGE=kentcode/bookllm-ocr:latest

# --- PostgreSQL (optional — defaults work out of the box) --------------
POSTGRES_USER=bookllm
POSTGRES_PASSWORD=bookllm
POSTGRES_DB=bookllm
POSTGRES_PORT=5432

# --- Redis (optional) --------------------------------------------------
REDIS_PORT=6379

# --- LLM initial fallback (optional — Settings UI overrides this) ------
# Settings UI accepts localhost for host-local runtimes; Docker normalizes it internally.
# This fallback is read by the backend container before Settings UI values are saved.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=local-dev-key
OPENAI_MODEL=

# --- Whole-book glossary/context cache --------------------------------
# Redis TTL in seconds for cached book context packages.
# Default: 604800 (7 days). Set to 0 to keep cache entries without expiry.
BOOK_CONTEXT_CACHE_TTL_SECONDS=604800

# --- Backend logging ---------------------------------------------------
# Production containers default to structured JSON logs on stdout.
LOG_FORMAT=json
LOG_LEVEL=info
