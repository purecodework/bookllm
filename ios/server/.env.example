# Load outside source control; replace all blank values before server startup.
DATABASE_PATH=./data/bookllm.sqlite3
SESSION_SECRET=
APPLE_BUNDLE_ID=app.bookllm.ios
APPLE_APP_ID=
# Production for the live app; Sandbox only on a separate sandbox deployment/database.
APPLE_ENVIRONMENT=Production
# Absolute paths to DER Apple root CA certificates obtained from Apple's PKI page.
APPLE_ROOT_CERTIFICATES=/run/secrets/AppleRootCA-G3.cer,/run/secrets/AppleRootCA-G2.cer
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SESSION_TTL_SECONDS=604800
PER_ACCOUNT_CONCURRENCY=4
GLOBAL_CONCURRENCY=32
REQUEST_TIMEOUT_SECONDS=180

# Let app-owned streaming work finish during restart before marking remaining jobs uncertain.
STREAM_SHUTDOWN_GRACE_SECONDS=10

# Each successful stage is settled from actual prompt_tokens + completion_tokens.
# 1 point / 1,000 tokens, rounded up per request; minimum 1 point.
TOKENS_PER_POINT=1000
# Reserve a bounded output allowance, reduced to available credits when sufficient.
MAX_OUTPUT_TOKENS=8192
MINIMUM_OUTPUT_TOKENS=128
